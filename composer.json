{
    "name": "amjad-ah/larascope",
    "description": "A Laravel package that logs HTTP requests, duration, status, SQL queries, and memory usage.",
    "keywords": [
        "laravel",
        "logging",
        "http",
        "request",
        "monitoring",
        "sql",
        "dashboard",
        "debugging",
        "performance"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AmjadAH",
            "email": "hi@amjad.codes"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadAH\\LaraScope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadAH\\LaraScope\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadAH\\LaraScope\\LaraScopeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
